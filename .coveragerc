[run]
# Coverage settings for the module-folder layout used in this repo.
# Excludes test files themselves and any local virtualenvs from the coverage measurement.
omit =
    */test_*.py
    */*_test.py
    */tests/*
    */.venv/*
    */venv/*
    */.git/*
    */__pycache__/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
