// EDUCATIONAL DRAFTS: not executed in Microsoft Sentinel. Validate schema and behaviour.
// Run EACH query separately. This is not a production analytic-rule deployment.
// Sources: https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/signinlogs
// https://learn.microsoft.com/en-us/entra/identity-platform/reference-error-codes

// 1. Credential-error sequence before the NEXT same-user/IP successful sign-in.
// 50126 = invalid username or password, not all nonzero authentication results.
// Narrowing a failure reason improves specificity but does not prove brute force.
// The next-success join avoids fixed-bin order mistakes and reusing failures after success.
let Window = 10m;
let MinimumFailures = 5;
let Events = materialize(
    SigninLogs
    | where TimeGenerated >= ago(1d)
    | where isnotempty(Id)
    | summarize arg_max(TimeGenerated, *) by Id
    | project EventId=Id, TimeGenerated, UserPrincipalName, IPAddress,
              Result=tostring(ResultType));
let Failures = Events
    | where Result == "50126"
    | project FailureId=EventId, FailureTime=TimeGenerated, UserPrincipalName, IPAddress;
let Successes = Events
    | where Result == "0"
    | project SuccessId=EventId, SuccessTime=TimeGenerated, UserPrincipalName, IPAddress;
Failures
| join kind=inner (Successes) on UserPrincipalName, IPAddress
| where FailureTime < SuccessTime and FailureTime >= SuccessTime - Window
| summarize arg_min(SuccessTime, *) by FailureId
| summarize FailureCount=count(), FirstFailure=min(FailureTime), LastFailure=max(FailureTime)
    by UserPrincipalName, IPAddress, SuccessId, SuccessTime
| where FailureCount >= MinimumFailures
| extend Assessment="Credential-attack candidate; investigate", TechniqueHypothesis="T1110; T1078"

// 2. MFA investigation CONTEXT query, not a validated MFA-fatigue detection.
// AuthenticationDetails is dynamic. Inspect actual tenant event samples and method/result
// semantics before defining denial/timeout/approval predicates. An error code alone must
// not be labelled push denial; an overall successful sign-in need not mean fresh MFA approval.
SigninLogs
| where TimeGenerated >= ago(1d)
| project TimeGenerated, Id, UserPrincipalName, IPAddress, ResultType,
          AuthenticationRequirement, AuthenticationDetails, Status, DeviceDetail
| order by UserPrincipalName asc, TimeGenerated asc

// 3. Cross-country sign-in hunting CONTEXT, not an impossible-travel calculation.
// This flags a location change for review; it does not estimate distance or physical travel.
SigninLogs
| where TimeGenerated >= ago(1d) and tostring(ResultType) == "0"
| extend Country=tostring(LocationDetails.countryOrRegion)
| where isnotempty(Country)
| project TimeGenerated, UserPrincipalName, IPAddress, Country, DeviceDetail
| sort by UserPrincipalName asc, TimeGenerated asc
| serialize
| extend PreviousUser=prev(UserPrincipalName), PreviousCountry=prev(Country),
         PreviousTime=prev(TimeGenerated)
| where UserPrincipalName == PreviousUser and Country != PreviousCountry
| where TimeGenerated - PreviousTime between (0s .. 2h)
| extend Assessment="Review VPN, geolocation, session and device context"
